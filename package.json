{
  "name": "catalejo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\" \"extension/**/*.test.mjs\"",
    "test:db": "bash supabase/tests/run.sh",
    "db:migrate": "for f in supabase/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\"; done",
    "e2e": "node --test --test-concurrency=1 e2e/app.e2e.mjs e2e/extension.e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^5.8.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "linkedom": "^0.18.12",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}