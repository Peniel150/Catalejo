# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local a git.

# Sitio
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API y > Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena "Transaction pooler" (puerto 6543)
DATABASE_URL=

# Cron (Vercel envía "Authorization: Bearer CRON_SECRET")
CRON_SECRET=

# Mercado Pago: usa primero credenciales de PRUEBA (Tus integraciones > Credenciales de prueba)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Precio mensual en pesos chilenos (lo define /replica-launch)
MP_PRICE_BASIC_CLP=
MP_PRICE_ADVANCED_CLP=
# Precio anual (2 meses gratis)
MP_PRICE_BASIC_YEARLY_CLP=
MP_PRICE_ADVANCED_YEARLY_CLP=
